node_modules/
# ...and the SYMLINK a git worktree needs. `node_modules/` matches the
# directory only; a worktree has no node_modules of its own, so every lane
# links the repo's, and that link is a file that walked straight past the
# line above and into two commits before anyone noticed.
node_modules
.next/
out/
*.tsbuildinfo
next-env.d.ts
test/artifacts/
test/_*.mjs
.DS_Store
.vercel
public/assets-staging/
.claude/worktrees/

# Built cockpit interiors ARE committed, unlike most build output: Vercel
# deploys from git, so a gitignored interior means every visitor silently falls
# back to the procedural one. Rebuild the shipped one with:
#
#   node tools/build-cockpit.mjs public/assets-staging/volvo_s90_recharge_free.glb \
#     --out volvo-s90-full --no-clip --full-cabin --simplify --meshopt \
#     --tex 2048 --jpeg-q 82
#
# 3.27M tris / 45 images -> 357k tris / 21 images, 7.4 MB. Every flag is
# load-bearing; --tex and --jpeg-q are the two size levers, the rest change
# what the asset IS. See the header of tools/build-cockpit.mjs.
#
# The retired frustum-CUT dash lives at public/assets-staging/interiors/
# (gitignored, not shipped) and was built by the same tool with no flags but
# `--out volvo-s90`. It is out of the game — see COCKPIT_MODEL in player.ts.
#
# Keep an eye on history weight if the build is re-tuned often: binaries do not
# delta, so each rebuild adds another full copy permanently.

# scratch files the audit/probe agents drop while running in this tree
test/.probe*.tmp.mjs
